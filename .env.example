# Neon Postgres connection string (set locally in .env.local and in Vercel project settings)
DATABASE_URL= ''

# Generate with: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Groq OpenAI-compatible API. Keep this server-side; never prefix with NEXT_PUBLIC_.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DAILY_MODEL_CALL_LIMIT=60

# Create a PRIVATE Vercel Blob store from the Vercel project Storage tab.
# If your store uses a custom environment prefix, the app also accepts BLOB1_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
