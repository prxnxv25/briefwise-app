# Neon Postgres connection string (set locally in .env.local and in Vercel project settings)
DATABASE_URL= ''

# Generate with: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# MiniMax Anthropic-compatible API. Keep this server-side; never prefix with NEXT_PUBLIC_.
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
ANTHROPIC_API_KEY=
MINIMAX_MODEL=MiniMax-M3
DAILY_MODEL_CALL_LIMIT=60

# Create a PRIVATE Vercel Blob store from the Vercel project Storage tab.
BLOB_READ_WRITE_TOKEN=
